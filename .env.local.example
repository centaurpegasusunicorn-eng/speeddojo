# Copy this file to .env.local and fill in your real values
# Find these in Supabase: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare R2 (video storage). Leave these out to use the videos in /public.
# Find them in Cloudflare: R2 > Manage API tokens (use a read-only token)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=speeddojo-videos
