# Copy this file to .env.local and fill in your real values
# Find these in Supabase: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare R2 (video storage). Leave these out to use the videos in /public.
# Find them in Cloudflare: R2 > Manage API tokens (use a read-only token)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=speeddojo-videos

# Stripe (payments). Leave these out and everything stays unlocked.
# Sandbox keys start sk_test_. Find them in Stripe: Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase secret key, used only by the server to record payments.
# Supabase: Project Settings > API Keys (service_role / secret). Never share.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
